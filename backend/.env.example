PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=stalla
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

WEB_BASE_URL=http://localhost:5173

